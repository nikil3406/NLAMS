NODE_ENV=development

# Database — PostgreSQL 15 + PostGIS (added in Phase 1 Step 2)
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/nlams

# Seed admin credentials — used only by the db:seed script, never stored
SEED_ADMIN_EMAIL=admin@nlams.gov.in
SEED_ADMIN_PASSWORD=

# Authentication — Phase 1 Step 3
AUTH_SECRET=your-random-32-byte-secret-key-min-32-chars
